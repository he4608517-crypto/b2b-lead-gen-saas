# =============================================================================
# B2B Lead Gen SaaS — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual credentials.
# WARNING: .env contains secrets — never commit it to version control.

# ---------------------------------------------------------------------------
# LLM — Gemini / Claude (at least one required for filtering + outreach)
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Gemini (vertex AI / google-genai)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Claude (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Data Sources (all optional — mock data is used when keys are missing)
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
LINKEDIN_ACCESS_TOKEN=
APOLLO_API_KEY=

# ---------------------------------------------------------------------------
# SMTP — Email delivery (REQUIRED for real sends; --dry-run works without)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# WhatsApp — Meta Business API (optional; mock-logged when unset)
# ---------------------------------------------------------------------------
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------------------------------------------------------------------------
# Sender identity (used in email/WhatsApp sign-offs)
# ---------------------------------------------------------------------------
SENDER_NAME=Alex Chen
SENDER_COMPANY=GlobalComp Manufacturing

# ---------------------------------------------------------------------------
# JWT signing secret (auto-generated at startup if left empty)
# ---------------------------------------------------------------------------
JWT_SECRET=
